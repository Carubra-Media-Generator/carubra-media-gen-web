# ═══════════════════════════════════════════
# SUPABASE
# ═══════════════════════════════════════════
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=public

# ═══════════════════════════════════════════
# JWT & APP CONFIG
# ═══════════════════════════════════════════
JWT_SECRET=your-jwt-secret-here
NEXT_PUBLIC_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PORT=3000
TEST_MODE=true
USE_MOCK_DB=false
CRON_SECRET=your-cron-secret-here
WORKER_INTERVAL_MS=60000

# ═══════════════════════════════════════════
# GOOGLE CLOUD / VERTEX AI (Video & Image Generation)
# ═══════════════════════════════════════════
GOOGLE_APPLICATION_CREDENTIALS=./credentials/vertex.json
GOOGLE_CLOUD_PROJECT=carbura-501706
VERTEX_LOCATION=us-central1
VERTEX_MODEL=veo-2.0-generate-001
VERTEX_OUTPUT_GCS_URI=gs://bucketcaruba/videos/

# ═══════════════════════════════════════════
# AI CAPTION / IMAGE / VIDEO GENERATION (LiteLLM)
# ═══════════════════════════════════════════
CAPTION_API_KEY=your-litellm-api-key
CAPTION_API_URL=https://litellm.yourdomain.com
CAPTION_MODEL=carubra/flash-3

IMAGE_API_KEY=your-litellm-api-key
IMAGE_API_URL=https://litellm.yourdomain.com
IMAGE_MODEL=carubra/image-3-pro

VIDEO_API_KEY=your-litellm-api-key
VIDEO_API_URL=https://litellm.yourdomain.com
VIDEO_MODEL=carubra/video-3.1

CONTENT_API_KEY=your-litellm-api-key
CONTENT_API_URL=https://litellm.yourdomain.com/v1
CONTENT_MODEL=carubra/flash-3

# ═══════════════════════════════════════════
# FACEBOOK / INSTAGRAM (Meta)
# ═══════════════════════════════════════════
FACEBOOK_APP_ID=your-facebook-app-id
FB_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FB_APP_SECRET=your-facebook-app-secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/social-connect/facebook/callback
FB_REDIRECT_URI=http://localhost:3000/api/social-connect/facebook/callback
FACEBOOK_REDIRECT_URI_VERCEL=https://your-domain.vercel.app/api/social-connect/facebook/callback
FACEBOOK_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/social-connect/instagram/callback
IG_REDIRECT_URI=http://localhost:3000/api/social-connect/instagram/callback
INSTAGRAM_REDIRECT_URI_VERCEL=https://your-domain.vercel.app/api/social-connect/instagram/callback
IG_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# ═══════════════════════════════════════════
# YOUTUBE (Google)
# ═══════════════════════════════════════════
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/social-connect/youtube/callback
YOUTUBE_REDIRECT_URI_VERCEL=https://your-domain.vercel.app/api/social-connect/youtube/callback

# ═══════════════════════════════════════════
# TIKTOK
# ═══════════════════════════════════════════
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_ID=your-tiktok-client-id
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=http://localhost:3000/api/social-connect/tiktok/callback
TIKTOK_REDIRECT_URI_VERCEL=https://your-domain.vercel.app/api/social-connect/tiktok/callback
TIKTOK_WEBHOOK_VERIFY_TOKEN=your-tiktok-webhook-verify-token

# ═══════════════════════════════════════════
# TWITTER / X
# ═══════════════════════════════════════════
TWITTER_CLIENT_ID=your-twitter-client-id
X_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret
X_CLIENT_SECRET=your-twitter-client-secret
TWITTER_REDIRECT_URI=http://localhost:3000/api/social-connect/twitter/callback
X_REDIRECT_URI=http://localhost:3000/api/social-connect/twitter/callback
TWITTER_REDIRECT_URI_VERCEL=https://your-domain.vercel.app/api/social-connect/twitter/callback
X_REDIRECT_URI_VERCEL=https://your-domain.vercel.app/api/social-connect/twitter/callback

# ═══════════════════════════════════════════
# THREADS (Meta)
# ═══════════════════════════════════════════
THREADS_CLIENT_ID=your-threads-client-id
THREADS_CLIENT_SECRET=your-threads-client-secret
THREADS_REDIRECT_URI=http://localhost:3000/api/social-connect/threads/callback
THREADS_REDIRECT_URI_VERCEL=https://your-domain.vercel.app/api/social-connect/threads/callback

# ═══════════════════════════════════════════
# WHATSAPP / GOWA
# ═══════════════════════════════════════════
GOWA_BASE_URL=https://gowa.yourdomain.com
GOWA_USERNAME=admin
GOWA_PASSWORD=your-password
GOWA_CLIENT_ID=your-gowa-client-id
GOWA_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/your-webhook-id

# ═══════════════════════════════════════════
# PAYMENTS (Xendit)
# ═══════════════════════════════════════════
XENDIT_SECRET_KEY=your-xendit-secret-key
XENDIT_WEBHOOK_TOKEN=your-xendit-webhook-token
XENDIT_REDIRECT_URL=https://yourdomain.com/payment-success
